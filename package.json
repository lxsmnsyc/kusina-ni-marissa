{
  "name": "kusina-ni-marissa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.ts",
    "build": "vite build --outDir dist/client && vite build --ssr src/server.ts --outDir dist/server",
    "preview": "node preview.ts",
    "typecheck": "brumate-tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "brumate check"
  },
  "dependencies": {
    "brumate": "0.6.0"
  },
  "devDependencies": {
    "@brumate/tsc": "0.1.12",
    "@types/node": "26.6.6",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vite": "8.3.4",
    "yaml": "2.9.1"
  }
}
